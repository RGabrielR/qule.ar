# Copiá este archivo a .env (nunca subas .env al repo)

# Obligatoria en producción. Generala con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Login con Google (opcional). Redirección: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave que cifra los datos de salud en la base. Obligatoria en producción (en desarrollo se crea sola en ./data).
# Generala con: openssl rand -base64 32. Si se pierde, esos datos no se recuperan.
DATA_KEY=

# Postgres real (opcional). Si no está, se usa PGlite en ./data
DATABASE_URL=

# Procesos del API (solo con DATABASE_URL). Por defecto, uno por núcleo menos uno, hasta 4. 1 = un solo proceso.
# WORKERS=

# URL pública de la web
APP_URL=http://localhost:5173

# Mails: recuperar la contraseña y avisos de moderación (cualquier SMTP). Ej. con Amazon SES:
# SMTP_URL=smtps://USUARIO_SMTP:CLAVE_SMTP@email-smtp.eu-west-1.amazonaws.com:465
# Tope de mails en 24 horas, entre todos (frena un ataque antes de que cueste plata)
# MAIL_DAILY_CAP=2000
# MAIL_FROM=mortero <hola@tu-dominio.com>
SMTP_URL=
MAIL_FROM=

# Encabezado con la IP real de cada persona (ver docs/DEPLOY.md): cf-connecting-ip (túnel de Cloudflare) o x-real-ip (nginx)
# CLIENT_IP_HEADER=cf-connecting-ip
# IDs de cuenta con acceso a moderación (ver README). ADMIN_EMAILS solo cuenta con el mail verificado.
# ADMIN_USER_IDS=

# Fotos y videos: en disco (por defecto) o en Cloudflare R2 / S3. Ver docs/DEPLOY.md, "Fotos en Cloudflare R2".
# STORAGE=s3
# S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
# S3_BUCKET=qule-fotos
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
