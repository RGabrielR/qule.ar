{
  "name": "mortero",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace api & npm run dev --workspace web; wait",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "db:generate": "npm run db:generate --workspace api",
    "build": "npm run build --workspace web",
    "test": "npm test --workspace api",
    "vapid": "node --input-type=module -e \"import {generateVAPIDKeys} from 'web-push'; const k=generateVAPIDKeys(); console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\\nVAPID_PRIVATE_KEY='+k.privateKey)\"",
    "typecheck": "npm run typecheck --workspace api && npm run typecheck --workspace web",
    "lint": "npm run lint:css && npm run lint:brand",
    "lint:css": "stylelint \"apps/web/src/**/*.css\"",
    "lint:brand": "node scripts/check-brand.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "stylelint": "^18.1.0"
  }
}
